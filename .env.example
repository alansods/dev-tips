# Copie para .env (fora do Git) e preencha com os valores do Google Cloud.
# Nenhum destes valores é segredo: todos acabam dentro do app.

# Endereço da API (padrão: a API publicada no Cloudflare Workers).
EXPO_PUBLIC_API_URL=https://dev-tips-api.dev-tips-api.workers.dev

# Client ID do tipo "Aplicativo da Web": o público (aud) que a API confere.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Client ID do tipo "iOS" e o "Esquema de URL do iOS" mostrado na página dele.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Chave pública do RevenueCat para Android (Project settings > API keys, começa com goog_).
# Sem ela, a venda do Pro fica desligada.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
